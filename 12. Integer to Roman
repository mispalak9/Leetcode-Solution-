class Solution(object):
    def intToRoman(self, num):
        """
        :type num: int
        :rtype: str
        """
        # Define the mapping of integers to Roman numerals
        val = [
            1000, "M",
            900, "CM",
            500, "D",
            400, "CD",
            100, "C",
            90, "XC",
            50, "L",
            40, "XL",
            10, "X",
            9, "IX",
            5, "V",
            4, "IV",
            1, "I"
        ]
        
        roman_numeral = ""
        
        # Iterate over the values and build the Roman numeral
        for i in range(0, len(val), 2):
            while num >= val[i]:
                roman_numeral += val[i + 1]  # Append the Roman numeral
                num -= val[i]  # Subtract the value from num
        
        return roman_numeral
