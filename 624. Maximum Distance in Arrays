class Solution(object):
    def maxDistance(self, arrays):
        """
        :type arrays: List[List[int]]
        :rtype: int
        """
        # Initialize the minimum and maximum values from the first array
        min_val = arrays[0][0]
        max_val = arrays[0][-1]
        max_distance = 0
        
        # Iterate through the arrays starting from the second one
        for i in range(1, len(arrays)):
            # Calculate the distance with the current array's min and max
            max_distance = max(max_distance, abs(arrays[i][-1] - min_val), abs(max_val - arrays[i][0]))
            
            # Update the min and max values
            min_val = min(min_val, arrays[i][0])
            max_val = max(max_val, arrays[i][-1])
        
        return max_distance

# Example usage
solution = Solution()
arrays = [[1, 4], [0, 5]]
print(solution.maxDistance(arrays))  # Output: 5
